# Firebase (replace with your project values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (for uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=

# Notes:
# - Copy this file to .env.local and fill values for local development.
# - Do NOT commit your real .env.local to version control.
# - The app contains a local fallback for Firebase for convenience, but you
#   should still provide your own credentials for real testing and production.
